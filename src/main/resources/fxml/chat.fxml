      </Label>
      <Button fx:id="btnViewEvidence1" alignment="CENTER" layoutX="655.0" layoutY="505.0" mnemonicParsing="false" onAction="#onViewEvidence" prefHeight="170.0" prefWidth="207.0" rotate="10.0" styleClass="folder-icon-button" text="📁" textFill="#D2B48C">
         <font>
            <Font size="87.0" />
         </font></Button>
  </children>
</AnchorPane>
