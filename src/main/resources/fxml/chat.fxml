<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1000.0" styleClass="chat-container-human" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.ChatController">
  <children>
      <ImageView fitHeight="650.0" fitWidth="1006.0" layoutX="-1.0" pickOnBounds="true">
         <image>
            <Image url="@../images/dinner_resize.png" />
         </image>
      </ImageView>
    <TextArea fx:id="txtaChat" editable="false" layoutX="65.0" layoutY="71.0" prefHeight="447.0" prefWidth="426.0" styleClass="chat-display-human" wrapText="true" />
    <TextField fx:id="txtInput" layoutX="65.0" layoutY="532.0" prefHeight="37.0" prefWidth="339.0" styleClass="chat-input-human" />
    <Button fx:id="btnSend" layoutX="413.0" layoutY="532.0" mnemonicParsing="false" onAction="#onSendMessage" prefHeight="37.0" prefWidth="78.0" styleClass="chat-send-button-human" text="Send" />
    <Button layoutX="902.0" layoutY="14.0" mnemonicParsing="false" onAction="#onGoBack" prefHeight="37.0" prefWidth="84.0" styleClass="cyber-back-button-human" text="Go Back" />
      <Label fx:id="lblTimer" layoutX="14.0" layoutY="18.0" styleClass="cyber-timer-human" text="Label" textFill="WHITE">
