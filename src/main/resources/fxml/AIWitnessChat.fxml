      <Button fx:id="btnViewEvidence2" layoutX="711.0" layoutY="570.0" mnemonicParsing="false" onAction="#onViewEvidence" rotate="6.3" styleClass="view-evidence-button-ai" text="View Evidence" />
      <Label fx:id="fbLabel" layoutX="390.0" layoutY="17.0" styleClass="feedback-label-ai" text="Click the button to view evidence" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
  </children>
</AnchorPane>
